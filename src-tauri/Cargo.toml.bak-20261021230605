[package]
name = "app"
version = "0.1.0"
description = "A Tauri App"
authors = ["you"]
license = ""
repository = ""
edition = "2024"
rust-version = "1.90"

[lib]
name = "app_lib"
crate-type = ["staticlib", "cdylib", "rlib"]

[build-dependencies]
# 修改為符合 tauri 2.11.5 需求的相容區間
tauri = { version = "=2.11.5", features = ["protocol-asset"] }

[dependencies]
serde_json = "1.0"
serde = { version = "1.0", features = ["derive"] }
log = "0.4"

# 強制對齊外掛要求的 tauri 2.11.5
tauri = { version = "=2.11.5", features = [] }
tauri-plugin-shell = "^2.0"
tauri-plugin-log = "^2.0"
tauri-plugin-printer-v2 = "0.6"

[patch.crates-io]
tauri-runtime = { git = "https://github.com/tauri-apps/tauri", tag = "tauri-runtime-v2.11.1" }
tauri-runtime-wry = { git = "https://github.com/tauri-apps/tauri", tag = "tauri-runtime-wry-v2.11.3" }
wry = { git = "https://github.com", tag = "wry-v0.47.1" }
tao = { git = "https://github.com/tauri-apps/tao", tag = "tao-v0.31.1" }
webview2-com = { git = "https://github.com", tag = "v0.33.0" }
webview2-com-sys = { git = "https://github.com", tag = "v0.33.0" }


