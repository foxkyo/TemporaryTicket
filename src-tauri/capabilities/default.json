{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: core APIs and silent_print for the local Laravel frontend",
  "windows": ["main"],
  "remote": {
    "urls": [
      "https://localhost/",
      "https://localhost/*",
      "https://localhost:*/*",
      "http://localhost/",
      "http://localhost/*",
      "http://localhost:*/*"
    ]
  },
  "permissions": [
    "core:default",
    "allow-silent-print"
  ]
}
